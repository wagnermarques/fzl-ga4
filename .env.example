# Copie este arquivo para .env.local e preencha.
#
# VITE_GOOGLE_OAUTH_CLIENT_ID é o "ID do cliente OAuth 2.0" (tipo *Aplicativo
# da Web*) criado no Google Cloud Console. É com ele que o app pede, no
# navegador, permissão de leitura (analytics.readonly) às propriedades do
# GA4 da sua conta Google — não há backend nem service account: o token fica
# só na aba do navegador. Passo a passo no README.md.
VITE_GOOGLE_OAUTH_CLIENT_ID=

# Path base do deploy. Em GitHub Pages: /fzl-fund-ga4-projects-views/
# Deixe em branco para servir na raiz (dev e preview locais).
VITE_BASE_PATH=
